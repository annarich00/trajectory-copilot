% Generated by src/gmat_verify.py for GUI-mode OrbitView preview (TJC-2);
% units: km, km/s, seconds. Mirrors generate_gmat_script's Spacecraft/Burn
% setup for the same CW rendezvous case, substituting a real OrbitView
% resource for ReportFile numeric output.

%----------------------------------------
%---------- Spacecraft
%----------------------------------------

Create Spacecraft Chief;
Chief.DateFormat = UTCGregorian;
Chief.Epoch = '01 Jan 2026 00:00:00.000';
Chief.CoordinateSystem = EarthMJ2000Eq;
Chief.DisplayStateType = Keplerian;
Chief.SMA = 6778.137;
Chief.ECC = 0;
Chief.INC = 0;
Chief.RAAN = 0;
Chief.AOP = 0;
Chief.TA = 0;
Chief.DryMass = 850;
Chief.Cd = 2.2;
Chief.Cr = 1.8;
Chief.DragArea = 15;
Chief.SRPArea = 1;
Chief.SPADDragScaleFactor = 1;
Chief.SPADSRPScaleFactor = 1;
Chief.AtmosDensityScaleFactor = 1;
Chief.ExtendedMassPropertiesModel = 'None';
Chief.NAIFId = -10001001;
Chief.NAIFIdReferenceFrame = -9001001;
Chief.OrbitColor = [0 180 255];
Chief.TargetColor = Teal;
Chief.OrbitErrorCovariance = [ 1e+70 0 0 0 0 0 ; 0 1e+70 0 0 0 0 ; 0 0 1e+70 0 0 0 ; 0 0 0 1e+70 0 0 ; 0 0 0 0 1e+70 0 ; 0 0 0 0 0 1e+70 ];
Chief.CdSigma = 1e+70;
Chief.CrSigma = 1e+70;
Chief.Id = 'SatId';
Chief.Attitude = CoordinateSystemFixed;
Chief.SPADSRPInterpolationMethod = Bilinear;
Chief.SPADSRPScaleFactorSigma = 1e+70;
Chief.SPADDragInterpolationMethod = Bilinear;
Chief.SPADDragScaleFactorSigma = 1e+70;
Chief.AtmosDensityScaleFactorSigma = 1e+70;
Chief.ModelFile = 'aura.3ds';
Chief.ModelOffsetX = 0;
Chief.ModelOffsetY = 0;
Chief.ModelOffsetZ = 0;
Chief.ModelRotationX = 0;
Chief.ModelRotationY = 0;
Chief.ModelRotationZ = 0;
Chief.ModelScale = 3;
Chief.AttitudeDisplayStateType = 'Quaternion';
Chief.AttitudeRateDisplayStateType = 'AngularVelocity';
Chief.AttitudeCoordinateSystem = EarthMJ2000Eq;
Chief.EulerAngleSequence = '321';

Create Spacecraft Deputy;

Deputy.DateFormat = UTCGregorian;
Deputy.Epoch = '01 Jan 2026 00:00:00.000';
Deputy.CoordinateSystem = LVLH;
Deputy.DisplayStateType = Cartesian;
Deputy.X = 0;
Deputy.Y = 20;
Deputy.Z = 0;
Deputy.VX = 0;
Deputy.VY = 0;
Deputy.VZ = 0;
Deputy.DryMass = 850;
Deputy.Cd = 2.2;
Deputy.Cr = 1.8;
Deputy.DragArea = 15;
Deputy.SRPArea = 1;
Deputy.SPADDragScaleFactor = 1;
Deputy.SPADSRPScaleFactor = 1;
Deputy.AtmosDensityScaleFactor = 1;
Deputy.ExtendedMassPropertiesModel = 'None';
Deputy.NAIFId = -10002001;
Deputy.NAIFIdReferenceFrame = -9002001;
Deputy.OrbitColor = [255 160 0];
Deputy.TargetColor = LightGray;
Deputy.OrbitErrorCovariance = [ 1e+70 0 0 0 0 0 ; 0 1e+70 0 0 0 0 ; 0 0 1e+70 0 0 0 ; 0 0 0 1e+70 0 0 ; 0 0 0 0 1e+70 0 ; 0 0 0 0 0 1e+70 ];
Deputy.CdSigma = 1e+70;
Deputy.CrSigma = 1e+70;
Deputy.Id = 'SatId';
Deputy.Attitude = CoordinateSystemFixed;
Deputy.SPADSRPInterpolationMethod = Bilinear;
Deputy.SPADSRPScaleFactorSigma = 1e+70;
Deputy.SPADDragInterpolationMethod = Bilinear;
Deputy.SPADDragScaleFactorSigma = 1e+70;
Deputy.AtmosDensityScaleFactorSigma = 1e+70;
Deputy.ModelFile = 'aura.3ds';
Deputy.ModelOffsetX = 0;
Deputy.ModelOffsetY = 0;
Deputy.ModelOffsetZ = 0;
Deputy.ModelRotationX = 0;
Deputy.ModelRotationY = 0;
Deputy.ModelRotationZ = 0;
Deputy.ModelScale = 3;
Deputy.ModelRotationZ = 90;
Deputy.AttitudeDisplayStateType = 'Quaternion';
Deputy.AttitudeRateDisplayStateType = 'AngularVelocity';
Deputy.AttitudeCoordinateSystem = EarthMJ2000Eq;
Deputy.EulerAngleSequence = '321';


%----------------------------------------
%---------- ForceModels
%----------------------------------------

Create ForceModel FM;
FM.CentralBody = Earth;
FM.PrimaryBodies = {Earth};
FM.Drag = None;
FM.SRP = Off;
FM.RelativisticCorrection = Off;
FM.ErrorControl = RSSStep;
FM.GravityField.Earth.Degree = 0;
FM.GravityField.Earth.Order = 0;
FM.GravityField.Earth.StmLimit = 100;
FM.GravityField.Earth.PotentialFile = '../data/gravity/earth/JGM2.cof';
FM.GravityField.Earth.TideModel = 'None';

%----------------------------------------
%---------- Propagators
%----------------------------------------

Create Propagator Prop;
Prop.FM = FM;
Prop.Type = RungeKutta89;
Prop.InitialStepSize = 60;
Prop.Accuracy = 9.999999999999999e-12;
Prop.MinStep = 0.001;
Prop.MaxStep = 2700;
Prop.MaxStepAttempts = 50;
Prop.StopIfAccuracyIsViolated = true;

%----------------------------------------
%---------- Burns
%----------------------------------------

Create ImpulsiveBurn Burn1;
Burn1.CoordinateSystem = LVLH;
Burn1.Element1 = 0;
Burn1.Element2 = 6.0020865123843e-05;
Burn1.Element3 = 0;
Burn1.DecrementMass = false;
Burn1.Isp = 300;
Burn1.GravitationalAccel = 9.81;

Create ImpulsiveBurn Burn2;
Burn2.CoordinateSystem = LVLH;
Burn2.Element1 = 0;
Burn2.Element2 = -6.0020865123843e-05;
Burn2.Element3 = 0;
Burn2.DecrementMass = false;
Burn2.Isp = 300;
Burn2.GravitationalAccel = 9.81;

%----------------------------------------
%---------- Coordinate Systems
%----------------------------------------

Create CoordinateSystem LVLH;
LVLH.Origin = Chief;
LVLH.Axes = ObjectReferenced;
LVLH.XAxis = R;
LVLH.ZAxis = N;
LVLH.Primary = Earth;
LVLH.Secondary = Chief;

%----------------------------------------
%---------- Subscribers
%----------------------------------------

Create OpenFramesInterface TrajectoryView;
TrajectoryView.SolverIterations = Current;
TrajectoryView.UpperLeft = [0.02 0.04];
TrajectoryView.Size = [0.96 0.88];
TrajectoryView.RelativeZOrder = 39;
TrajectoryView.Maximized = true;

TrajectoryView.Add = {Chief, Deputy, Earth};
TrajectoryView.View = {TrajectoryView_View, NewView1};
TrajectoryView.CoordinateSystem = EarthMJ2000Eq;

TrajectoryView.DrawObject = [true true true];
TrajectoryView.DrawTrajectory = [true true true];
TrajectoryView.DrawAxes = [false false false];
TrajectoryView.DrawXYPlane = [false false false];
TrajectoryView.DrawLabel = [true true true];
TrajectoryView.DrawCenterPoint = [false false false];
TrajectoryView.DrawEndPoints = [true true true];
TrajectoryView.DrawVelocity = [false false false];
TrajectoryView.DrawGrid = [false false false];
TrajectoryView.DrawFontPosition = {'Top-Left', 'Top-Right', 'Top-Right'};

TrajectoryView.DrawLineWidth = [2 2 2];
TrajectoryView.DrawMarkerSize = [8 8 8];
TrajectoryView.DrawFontSize = [16 16 12];

TrajectoryView.Axes = On;
TrajectoryView.AxesLength = 12756.2726;
TrajectoryView.AxesLabels = Off;
TrajectoryView.FrameLabel = Off;
TrajectoryView.XYPlane = Off;
TrajectoryView.EclipticPlane = Off;
TrajectoryView.EnableStars = On;
TrajectoryView.ShowPlot = true;
TrajectoryView.ShowToolbar = true;

%----------------------------------------
%---------- User Objects
%----------------------------------------

Create OpenFramesView TrajectoryView_View;

TrajectoryView_View.ViewFrame = CoordinateSystem;
TrajectoryView_View.ViewTrajectory = Off;
TrajectoryView_View.InertialFrame = Off;

TrajectoryView_View.SetDefaultLocation = On;
TrajectoryView_View.SetCurrentLocation = Off;

TrajectoryView_View.DefaultEye = [0 0 30000];
TrajectoryView_View.DefaultCenter = [0 0 0];
TrajectoryView_View.DefaultUp = [0 0 1];

TrajectoryView_View.FOVy = 45;

Create OpenFramesView NewView1;

NewView1.DefaultEye = [0 -3 1];
NewView1.DefaultCenter = [0 0 0];
NewView1.DefaultUp = [0 0 1];

NewView1.ViewFrame = Chief;
NewView1.ViewTrajectory = Off;
NewView1.InertialFrame = Off;
NewView1.LookAtFrame = Chief;
NewView1.ShortestAngle = Off;

NewView1.SetDefaultLocation = Off;
NewView1.SetCurrentLocation = On;

NewView1.DefaultEye = [0 -3 1];
NewView1.DefaultCenter = [0 0 0];
NewView1.DefaultUp = [0 0 1];

NewView1.CurrentEye = [0 -3 1];
NewView1.CurrentCenter = [0 0 0];
NewView1.CurrentUp = [0 0 1];
NewView1.FOVy = 45;

%----------------------------------------
%---------- Mission Sequence
%----------------------------------------


BeginMissionSequence;
Maneuver Burn1(Deputy);
Propagate Prop(Chief, Deputy) {Chief.ElapsedSecs = 5553.624271252};
Maneuver Burn2(Deputy);

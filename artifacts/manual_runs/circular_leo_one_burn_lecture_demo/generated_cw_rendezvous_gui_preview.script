Chief.ExtendedMassPropertiesModel = 'None';
Chief.NAIFId = -10001001;
Chief.NAIFIdReferenceFrame = -9001001;
Chief.OrbitColor = Red;
Chief.TargetColor = Teal;
Chief.OrbitErrorCovariance = [ 1e+70 0 0 0 0 0 ; 0 1e+70 0 0 0 0 ; 0 0 1e+70 0 0 0 ; 0 0 0 1e+70 0 0 ; 0 0 0 0 1e+70 0 ; 0 0 0 0 0 1e+70 ];
Chief.CdSigma = 1e+70;
Chief.CrSigma = 1e+70;
Chief.Id = 'SatId';
Chief.Attitude = CoordinateSystemFixed;
Chief.SPADSRPInterpolationMethod = Bilinear;
Chief.SPADSRPScaleFactorSigma = 1e+70;
Chief.SPADDragInterpolationMethod = Bilinear;
Chief.SPADDragScaleFactorSigma = 1e+70;
Chief.AtmosDensityScaleFactorSigma = 1e+70;
Chief.ModelFile = 'aura.3ds';
Chief.ModelOffsetX = 0;
Chief.ModelOffsetY = 0;
Chief.ModelOffsetZ = 0;
Chief.ModelRotationX = 0;
Chief.ModelRotationY = 0;
Chief.ModelRotationZ = 0;
Chief.ModelScale = 1;
Chief.AttitudeDisplayStateType = 'Quaternion';
Chief.AttitudeRateDisplayStateType = 'AngularVelocity';
Chief.AttitudeCoordinateSystem = EarthMJ2000Eq;
Chief.EulerAngleSequence = '321';

Create Spacecraft Deputy;

Deputy.DateFormat = UTCGregorian;
Deputy.Epoch = '01 Jan 2026 00:00:00.000';
Deputy.CoordinateSystem = LVLH;
Deputy.DisplayStateType = Cartesian;
Deputy.X = 0;
Deputy.Y = 1;
Deputy.Z = 0;
Deputy.VX = 0;
Deputy.VY = 0;
Deputy.VZ = 0;
Deputy.DryMass = 850;
Deputy.Cd = 2.2;
Deputy.Cr = 1.8;
Deputy.DragArea = 15;
Deputy.SRPArea = 1;
Deputy.SPADDragScaleFactor = 1;
Deputy.SPADSRPScaleFactor = 1;
Deputy.AtmosDensityScaleFactor = 1;
Deputy.ExtendedMassPropertiesModel = 'None';
Deputy.NAIFId = -10002001;
Deputy.NAIFIdReferenceFrame = -9002001;
Deputy.OrbitColor = Green;
Deputy.TargetColor = LightGray;
Deputy.OrbitErrorCovariance = [ 1e+70 0 0 0 0 0 ; 0 1e+70 0 0 0 0 ; 0 0 1e+70 0 0 0 ; 0 0 0 1e+70 0 0 ; 0 0 0 0 1e+70 0 ; 0 0 0 0 0 1e+70 ];
Deputy.CdSigma = 1e+70;
Deputy.CrSigma = 1e+70;
Deputy.Id = 'SatId';
Deputy.Attitude = CoordinateSystemFixed;
Deputy.SPADSRPInterpolationMethod = Bilinear;
Deputy.SPADSRPScaleFactorSigma = 1e+70;
Deputy.SPADDragInterpolationMethod = Bilinear;
Deputy.SPADDragScaleFactorSigma = 1e+70;

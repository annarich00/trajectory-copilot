TrajectoryView.AxesLabels = On;
TrajectoryView.FrameLabel = Off;
TrajectoryView.XYPlane = On;
TrajectoryView.EclipticPlane = Off;
TrajectoryView.EnableStars = On;
TrajectoryView.StarCatalog = 'inp_StarsHYGv3.txt';
TrajectoryView.StarCount = 40000;
TrajectoryView.MinStarMag = -2;
TrajectoryView.MaxStarMag = 6;
TrajectoryView.MinStarPixels = 1;
TrajectoryView.MaxStarPixels = 10;
TrajectoryView.MinStarDimRatio = 0.5;
TrajectoryView.ShowPlot = true;
TrajectoryView.ShowToolbar = true;
TrajectoryView.SolverIterLastN = 0;
TrajectoryView.ShowVR = false;
TrajectoryView.PlaybackTimeScale = 3600;
TrajectoryView.MultisampleAntiAliasing = On;
TrajectoryView.MSAASamples = 2;
TrajectoryView.DrawFontPosition = {'Top-Right', 'Top-Right', 'Top-Right'};

%----------------------------------------
%---------- User Objects
%----------------------------------------

Create OpenFramesView TrajectoryView_View;
TrajectoryView_View.ViewFrame = CoordinateSystem;
TrajectoryView_View.ViewTrajectory = Off;
TrajectoryView_View.InertialFrame = Off;
TrajectoryView_View.SetDefaultLocation = On;
TrajectoryView_View.DefaultEye = [ 0 0 30000 ];
TrajectoryView_View.DefaultCenter = [ 0 0 0 ];
TrajectoryView_View.DefaultUp = [ 0 0 1 ];
TrajectoryView_View.SetCurrentLocation = Off;
TrajectoryView_View.FOVy = 45;

Create OpenFramesView Attempt1;
Attempt1.ViewFrame = Chief;
Attempt1.ViewTrajectory = Off;
Attempt1.InertialFrame = On;
Attempt1.LookAtFrame = Chief;
Attempt1.ShortestAngle = Off;
Attempt1.SetDefaultLocation = On;
Attempt1.DefaultEye = [ 0 -1 15000 ];
Attempt1.DefaultCenter = [ 0 0 0 ];
Attempt1.DefaultUp = [ 0 0 1 ];
Attempt1.SetCurrentLocation = On;
Attempt1.CurrentEye = [ 0.5223210986395759 -2.298435544807734 1.128185452228238 ];
Attempt1.CurrentCenter = [ 0 4.440892098500626e-16 -2.220446049250313e-16 ];
Attempt1.CurrentUp = [ 0.1353379940022317 0.4611906803202341 0.8769189151598975 ];
Attempt1.FOVy = 45;


%----------------------------------------
%---------- Mission Sequence
%----------------------------------------


BeginMissionSequence;
Maneuver Burn1(Deputy);
Propagate Prop(Chief, Deputy) {Chief.ElapsedSecs = 5553.624271252};
Maneuver Burn2(Deputy);

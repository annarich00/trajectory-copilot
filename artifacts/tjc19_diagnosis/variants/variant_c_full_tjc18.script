% Generated by src/gmat_verify.py for GUI-mode OrbitView preview (TJC-2);
% units: km, km/s, seconds. Mirrors generate_gmat_script's Spacecraft/Burn
% setup for the same CW rendezvous case, substituting a real OrbitView
% resource for ReportFile numeric output.
Create Spacecraft Chief Deputy;
Chief.OrbitColor = [0 255 255];
Deputy.OrbitColor = [255 0 0];
Chief.DateFormat = UTCGregorian;
Chief.Epoch = '01 Jan 2026 00:00:00.000';
Chief.CoordinateSystem = EarthMJ2000Eq;
Chief.DisplayStateType = Keplerian;
Chief.SMA = 6778.137000000;
Chief.ECC = 0;
Chief.INC = 0;
Chief.RAAN = 0;
Chief.AOP = 0;
Chief.TA = 0;

Create ForceModel FM;
FM.CentralBody = Earth;
FM.PrimaryBodies = {Earth};
FM.GravityField.Earth.Degree = 0;
FM.GravityField.Earth.Order = 0;

Create Propagator Prop;
Prop.FM = FM;

Create CoordinateSystem LVLH;
LVLH.Origin = Chief;
LVLH.Axes = ObjectReferenced;
LVLH.Primary = Earth;
LVLH.Secondary = Chief;
LVLH.XAxis = R;
LVLH.ZAxis = N;

Deputy.DateFormat = UTCGregorian;
Deputy.Epoch = '01 Jan 2026 00:00:00.000';
Deputy.CoordinateSystem = LVLH;
Deputy.DisplayStateType = Cartesian;
Deputy.X = 0.000000000000000;
Deputy.Y = 1.000000000000000;
Deputy.Z = 0.000000000000000;
Deputy.VX = 0.000000000000000000;
Deputy.VY = 0.000000000000000000;
Deputy.VZ = 0.000000000000000000;

Create ImpulsiveBurn Burn1 Burn2;
Burn1.CoordinateSystem = LVLH;
Burn1.Element1 = 0.000000000000000000;
Burn1.Element2 = 0.000060020865123843;
Burn1.Element3 = 0.000000000000000000;
Burn2.CoordinateSystem = LVLH;
Burn2.Element1 = 0.000000000000000000;
Burn2.Element2 = -0.000060020865123843;
Burn2.Element3 = 0.000000000000000000;

Create OrbitView GlobalView;
GlobalView.Add = {Chief, Deputy, Earth};
GlobalView.CoordinateSystem = EarthMJ2000Eq;
GlobalView.ViewPointVector = [0 0 30000];
GlobalView.ViewDirection = Earth;
GlobalView.ShowPlot = true;

Create CoordinateSystem ChiefCentered;
ChiefCentered.Origin = Chief;
ChiefCentered.Axes = ObjectReferenced;
ChiefCentered.Primary = Earth;
ChiefCentered.Secondary = Chief;
ChiefCentered.XAxis = R;
ChiefCentered.ZAxis = N;

Create OrbitView CloseUpView;
CloseUpView.Add = {Chief, Deputy, Earth};
CloseUpView.CoordinateSystem = ChiefCentered;
CloseUpView.ViewPointVector = [0 0 5000];
CloseUpView.ViewDirection = Chief;
CloseUpView.ShowPlot = true;

Create XYPlot BurnMarkers;
BurnMarkers.XVariable = Deputy.ElapsedSecs;
BurnMarkers.YVariables = {Deputy.LVLH.X};
BurnMarkers.ShowPlot = true;

% Maneuver visualization data (TJC-18): burn markers are placed via
% MarkPoint on the BurnMarkers XYPlot at the moment each Maneuver command
% executes, so each marker corresponds to the maneuvering spacecraft's
% actual state at the actual burn epoch.
% Burn 1 -- spacecraft: Deputy; epoch: t = 0.000000000 s (mission start);
%   delta-v (LVLH ObjectReferenced frame, km/s): [0.000000000, 0.000060021, 0.000000000];
%   magnitude: 0.000060021 km/s.
% Burn 2 -- spacecraft: Deputy; epoch: t = 5553.624271252 s (end of transfer);
%   delta-v (LVLH ObjectReferenced frame, km/s): [0.000000000, -0.000060021, 0.000000000];
%   magnitude: 0.000060021 km/s.
BeginMissionSequence;
Maneuver Burn1(Deputy);
MarkPoint BurnMarkers;
Propagate Prop(Chief, Deputy) {Chief.ElapsedSecs = 5553.624271252};
Maneuver Burn2(Deputy);
MarkPoint BurnMarkers;
